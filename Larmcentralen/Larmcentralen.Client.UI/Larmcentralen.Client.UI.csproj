<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Every screen of Larmcentralen as Razor components. Hosted today by the Blazor Hybrid
    desktop app (Larmcentralen.App); a web host can serve the same components later
    without a rewrite. No MAUI dependency here.
  -->
  <PropertyGroup>
    <TargetFramework>$(LarmTargetFramework)</TargetFramework>
    <!-- scripts/ holds the TypeScript sources; its node_modules is tooling, never part of the build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);scripts/node_modules/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="ReverseMarkdown" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Larmcentralen.Client.Core\Larmcentralen.Client.Core.csproj" />
  </ItemGroup>

</Project>
