@* Shows an åtgärd as written in the editor: Markdown rendered by SolutionContent.ToHtml with raw HTML switched off
   and only safe link addresses, so anything that looks like HTML is shown as text. *@
<div class="rich-content">
    @if (SolutionContent.IsEmpty(Markdown))
    {
        <p class="muted">Ingen beskrivning ännu.</p>
    }
    else
    {
        @((MarkupString)_html)
    }
</div>

@code {
    private string? _rendered;
    private string _html = "";

    /// <summary>The stored content (Markdown).</summary>
    [Parameter] public string? Markdown { get; set; }

    protected override void OnParametersSet()
    {
        // Render only when the text changed, not on every re-render of the page.
        if (_rendered == Markdown && _rendered is not null) return;
        _rendered = Markdown;
        _html = SolutionContent.ToHtml(Markdown);
    }
}
