@implements IAsyncDisposable
@inject IJSRuntime JS
@*
    The search page's "Larmkod" filter: a searchable dropdown. Typing filters the codes (any part, any case, so "200.1"
    finds M200.1). "Alla" clears the filter and "Utan larmkod" shows alarms without a code. Arrow keys move, Enter picks,
    Esc closes and keeps the current choice.
*@

<div class="code-filter @(Value is null ? "" : "set")">
    <label for="code-filter-input">Larmkod</label>
    <input id="code-filter-input" @ref="_input" type="text" autocomplete="off" spellcheck="false"
           role="combobox" aria-autocomplete="list" aria-expanded="@(_open ? "true" : "false")"
           aria-controls="code-filter-list" aria-activedescendant="@(_open ? OptionId(_active) : null)"
           placeholder="Alla" value="@_query"
           @oninput="OnInput" @onkeydown="OnKeyDown" @onfocus="Open" @onblur="Close" @onclick="Open" />
    @if (_open)
    {
        <ul id="code-filter-list" class="code-filter-list" role="listbox" aria-label="Larmkoder">
            @for (var i = 0; i < _rows.Count; i++)
            {
                var index = i;
                var row = _rows[i];
                <li id="@OptionId(index)" role="option" aria-selected="@(row.Value == Value ? "true" : "false")"
                    class="@(index == _active ? "active" : "") @(row.Value == Value ? "current" : "") @(row.Value is null or AlarmSearchQuery.WithoutCode ? "special" : "")"
                    @onmousedown="() => PickAsync(index)" @onmousedown:preventDefault="true">@row.Label</li>
            }
            @if (_rows.Count == 0)
            {
                <li class="empty" role="presentation">Ingen larmkod matchar.</li>
            }
        </ul>
    }
</div>

@code {
    /// <summary>The codes to offer, in order (the page passes those present under its other filters).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Codes { get; set; } = [];

    /// <summary>Whether to offer "Utan larmkod".</summary>
    [Parameter] public bool OfferWithoutCode { get; set; }

    /// <summary>A code, <see cref="AlarmSearchQuery.WithoutCode"/>, or null for "Alla".</summary>
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private sealed record Row(string? Value, string Label);

    private ElementReference _input;
    private IJSObjectReference? _module;
    private IJSObjectReference? _keys;
    private string _query = "";
    private bool _open;
    private int _active;
    private List<Row> _rows = [];

    private static string OptionId(int index) => $"code-filter-option-{index}";

    private static string Label(string? value) => value switch
    {
        null => "",
        AlarmSearchQuery.WithoutCode => "Utan larmkod",
        _ => value
    };

    protected override void OnParametersSet()
    {
        if (!_open) _query = Label(Value);
        Refresh();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Without the script the filter still works; only Enter and the arrows would also act on the page.
        try
        {
            if (firstRender)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Larmcentralen.Client.UI/js/combobox.js");
                _keys = await _module.InvokeAsync<IJSObjectReference>("attach", _input);
            }
            if (_open && _module is not null)
                await _module.InvokeVoidAsync("scrollIntoView", OptionId(_active));
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    private void Refresh()
    {
        // While the box shows the current choice, offer everything; once the user types, filter by it.
        var typed = _query == Label(Value) ? "" : _query.Trim();
        _rows = [];
        if (typed.Length == 0)
        {
            _rows.Add(new Row(null, "Alla"));
            if (OfferWithoutCode) _rows.Add(new Row(AlarmSearchQuery.WithoutCode, "Utan larmkod"));
        }
        _rows.AddRange(Codes.Where(c => typed.Length == 0 || c.Contains(typed, StringComparison.OrdinalIgnoreCase))
            .Select(c => new Row(c, c)));
        if (typed.Length > 0 && OfferWithoutCode && "utan larmkod".Contains(typed, StringComparison.OrdinalIgnoreCase))
            _rows.Add(new Row(AlarmSearchQuery.WithoutCode, "Utan larmkod"));
        var current = _rows.FindIndex(r => r.Value == Value);
        _active = typed.Length == 0 && current >= 0 ? current : 0;
    }

    private void Open()
    {
        if (_open) return;
        _open = true;
        Refresh();
    }

    private void Close()
    {
        _open = false;
        _query = Label(Value);
    }

    private void OnInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        _open = true;
        Refresh();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
                if (!_open) Open();
                else if (_active < _rows.Count - 1) _active++;
                break;
            case "ArrowUp":
                if (!_open) Open();
                else if (_active > 0) _active--;
                break;
            case "Enter":
                if (_open) await PickAsync(_active);
                else Open();
                break;
            case "Escape":
                Close();
                break;
        }
    }

    private async Task PickAsync(int index)
    {
        if (index < 0 || index >= _rows.Count) return;
        var value = _rows[index].Value;
        _open = false;
        _query = Label(value);
        await ValueChanged.InvokeAsync(value);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_keys is not null) { await _keys.InvokeVoidAsync("dispose"); await _keys.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
