@implements IAsyncDisposable
@inject IJSRuntime JS
@* Word-like editing with the locally bundled Milkdown (js/milkdown-interop.js, built from scripts/src).
   Stores Markdown; nobody types markup. The toolbar is fixed above the text. Buttons start disabled and
   are switched on by the script once the editor runs. *@
<div class="md-editor" @ref="_root">
    <div class="md-toolbar" role="toolbar" aria-label="Formatering">
        <div class="md-group">
            <select data-cmd="block" title="Stycketyp" aria-label="Stycketyp" disabled>
                <option value="p">Brödtext</option>
                <option value="h2">Rubrik</option>
                <option value="h3">Underrubrik</option>
                <option value="" hidden>–</option>
            </select>
        </div>
        <div class="md-group">
            <button type="button" data-cmd="strong" title="Fet (Ctrl+B)" aria-label="Fet" aria-pressed="false" disabled><span class="glyph glyph-bold" aria-hidden="true">F</span></button>
            <button type="button" data-cmd="emphasis" title="Kursiv (Ctrl+I)" aria-label="Kursiv" aria-pressed="false" disabled><span class="glyph glyph-italic" aria-hidden="true">K</span></button>
            <button type="button" data-cmd="strike" title="Genomstruken" aria-label="Genomstruken" aria-pressed="false" disabled><span class="glyph glyph-strike" aria-hidden="true">abc</span></button>
        </div>
        <div class="md-group">
            <button type="button" data-cmd="ordered" title="Numrerad lista" aria-label="Numrerad lista" aria-pressed="false" disabled>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 6h11M10 12h11M10 18h11" /><path class="thin" d="M4 4.5h1.5V9M3.5 9h3.5M3.5 14.5c.4-.7 1-1 1.7-1 .9 0 1.6.6 1.6 1.4 0 1.4-3.3 2.6-3.3 4.1H7" /></svg>
            </button>
            <button type="button" data-cmd="bullet" title="Punktlista" aria-label="Punktlista" aria-pressed="false" disabled>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 6h11M10 12h11M10 18h11" /><circle cx="5" cy="6" r="1.6" class="dot" /><circle cx="5" cy="12" r="1.6" class="dot" /><circle cx="5" cy="18" r="1.6" class="dot" /></svg>
            </button>
        </div>
        <div class="md-group">
            @* One "Ruta" button for the Fara, Varning and Info boxes. Its icon shows the box the cursor is in;
               the script fills in the title ("Ruta" or "Ruta: Fara") and opens the menu below. *@
            <span class="md-box">
                <button type="button" data-cmd="box" class="md-box-button" data-kind="none" title="Ruta" aria-label="Ruta"
                        aria-haspopup="menu" aria-expanded="false" disabled>
                    <svg class="kind-none" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="2" /><path d="M7.5 5v14" /><path d="M11 10h6M11 14h4" /></svg>
                    <svg class="kind-caution" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.3 2.5h7.4l5.3 5.3v7.4l-5.3 5.3H8.3L3 15.2V7.8z" /><path d="M12 7.5v5.5" /><circle cx="12" cy="16.4" r="1.1" class="dot" /></svg>
                    <svg class="kind-warning" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 2.5 20h19z" /><path d="M12 10v4.5" /><circle cx="12" cy="17.2" r="1.1" class="dot" /></svg>
                    <svg class="kind-note" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5.5" /><circle cx="12" cy="7.8" r="1.1" class="dot" /></svg>
                    <svg class="caret" viewBox="0 0 10 10" aria-hidden="true"><path d="m2 3.5 3 3 3-3" /></svg>
                </button>
                <span class="md-box-menu" role="menu" aria-label="Ruta" hidden>
                    <button type="button" role="menuitemradio" aria-checked="false" data-box="caution" class="md-box-item kind-caution">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.3 2.5h7.4l5.3 5.3v7.4l-5.3 5.3H8.3L3 15.2V7.8z" /><path d="M12 7.5v5.5" /><circle cx="12" cy="16.4" r="1.1" class="dot" /></svg>
                        <span>Fara</span><span class="md-box-check" aria-hidden="true">✓</span>
                    </button>
                    <button type="button" role="menuitemradio" aria-checked="false" data-box="warning" class="md-box-item kind-warning">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 2.5 20h19z" /><path d="M12 10v4.5" /><circle cx="12" cy="17.2" r="1.1" class="dot" /></svg>
                        <span>Varning</span><span class="md-box-check" aria-hidden="true">✓</span>
                    </button>
                    <button type="button" role="menuitemradio" aria-checked="false" data-box="note" class="md-box-item kind-note">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5.5" /><circle cx="12" cy="7.8" r="1.1" class="dot" /></svg>
                        <span>Info</span><span class="md-box-check" aria-hidden="true">✓</span>
                    </button>
                    <span class="md-box-sep" role="separator"></span>
                    <button type="button" role="menuitem" data-box="none" class="md-box-item" title="Gör rutan till vanlig text">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="2" /><path d="m4 20 16-16" /></svg>
                        <span>Ingen ruta</span>
                    </button>
                </span>
            </span>
            <button type="button" data-cmd="code" title="Värde (kod)" aria-label="Värde (kod)" aria-pressed="false" disabled>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 7-5 5 5 5M16 7l5 5-5 5" /></svg>
            </button>
            <button type="button" data-cmd="codeBlock" title="Kodblock" aria-label="Kodblock" aria-pressed="false" disabled>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="m9 9.5-2.5 2.5L9 14.5M15 9.5l2.5 2.5-2.5 2.5" /></svg>
            </button>
            <button type="button" data-cmd="table" title="Tabell (3 × 3)" aria-label="Infoga tabell" disabled>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9.5h18M3 15h18M9 4v16M15 4v16" /></svg>
            </button>
            <button type="button" data-cmd="link" title="Länk (Ctrl+K)" aria-label="Länk" aria-pressed="false" disabled>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1" /><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1" /></svg>
            </button>
        </div>
        <div class="md-group">
            <button type="button" data-cmd="undo" title="Ångra (Ctrl+Z)" aria-label="Ångra" disabled>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14 4 9l5-5" /><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11" /></svg>
            </button>
            <button type="button" data-cmd="redo" title="Gör om (Ctrl+Y)" aria-label="Gör om" disabled>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 14 5-5-5-5" /><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13" /></svg>
            </button>
        </div>
    </div>

    <div class="md-linkbar" hidden>
        <label>
            <span>Länk</span>
            <input type="url" placeholder="https://…" autocomplete="off" spellcheck="false" />
        </label>
        <button type="button" class="btn btn-small btn-primary" data-link="save">Spara</button>
        <button type="button" class="btn btn-small" data-link="remove">Ta bort länk</button>
        <button type="button" class="btn btn-small" data-link="cancel">Avbryt</button>
        <p class="md-link-error" role="alert" hidden>Länken måste börja med https:// eller http://, eller vara en sökväg i appen.</p>
    </div>

    <div class="md-surface"></div>
</div>
@if (_loadError is not null)
{
    <p class="error" role="alert">@_loadError</p>
}

@code {
    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _editor;
    private string? _loadError;
    /// <summary>Set by DisposeAsync. The editor starts asynchronously, so the page can close while it starts.</summary>
    private bool _disposed;

    /// <summary>The Markdown the editor starts with. Read the current text with <see cref="GetMarkdownAsync"/>.</summary>
    [Parameter] public string? InitialMarkdown { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Skriv åtgärden här…";
    /// <summary>Accessible name of the text area, read by screen readers.</summary>
    [Parameter] public string Label { get; set; } = "Åtgärd, steg för steg";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Larmcentralen.Client.UI/js/milkdown-interop.js");
            if (_disposed)
            {
                await module.DisposeAsync();
                return;
            }
            _module = module;
            var editor = await module.InvokeAsync<IJSObjectReference>("create", _root, InitialMarkdown ?? "", Placeholder, Label);
            if (_disposed)
            {
                // The page closed while the editor was starting: DisposeAsync found nothing to clean up, so do it here.
                await DestroyAsync(module, editor);
                return;
            }
            _editor = editor;
        }
        catch (JSDisconnectedException)
        {
            // The page is closing; there is nothing to show.
        }
        catch (JSException ex)
        {
            if (_disposed) return;
            _loadError = $"Textredigeraren kunde inte startas. Stäng sidan och öppna den igen. ({ex.Message})";
            StateHasChanged();
        }
    }

    /// <summary>
    /// The editor's content as Markdown. Throws <see cref="InvalidOperationException"/> (Swedish message, for the
    /// page to show) when it can't be read, rather than handing back the old text and losing what was typed.
    /// </summary>
    public async Task<string> GetMarkdownAsync()
    {
        if (_module is null || _editor is null) return InitialMarkdown ?? "";
        try
        {
            return await _module.InvokeAsync<string>("getMarkdown", _editor);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            throw new InvalidOperationException("Texten i redigeraren kunde inte läsas.", ex);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        var (module, editor) = (_module, _editor);
        _module = null;
        _editor = null;
        await DestroyAsync(module, editor);
    }

    private static async Task DestroyAsync(IJSObjectReference? module, IJSObjectReference? editor)
    {
        try
        {
            if (module is not null && editor is not null) await module.InvokeVoidAsync("destroy", editor);
            if (editor is not null) await editor.DisposeAsync();
            if (module is not null) await module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException)
        {
            // The WebView is already gone, or the editor never started; nothing to clean up.
        }
    }
}
