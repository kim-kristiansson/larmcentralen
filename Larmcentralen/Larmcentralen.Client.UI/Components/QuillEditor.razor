@implements IAsyncDisposable
@inject IJSRuntime JS
@* Word-like rich text editing with the locally bundled Quill. Produces HTML; nobody types markup. *@
<div class="quill-editor">
    <div @ref="_host"></div>
</div>
@if (_loadError is not null)
{
    <p class="error" role="alert">@_loadError</p>
}

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _editor;
    private string? _loadError;

    /// <summary>The HTML the editor starts with. Read the current HTML with <see cref="GetHtmlAsync"/>.</summary>
    [Parameter] public string? InitialHtml { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Skriv åtgärden här…";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Larmcentralen.Client.UI/js/quill-interop.js");
            _editor = await _module.InvokeAsync<IJSObjectReference>("create", _host, InitialHtml ?? "", Placeholder);
        }
        catch (JSDisconnectedException)
        {
            // The page is closing; there is nothing to show.
        }
        catch (JSException ex)
        {
            _loadError = $"Textredigeraren kunde inte startas. Stäng sidan och öppna den igen. ({ex.Message})";
            StateHasChanged();
        }
    }

    /// <summary>
    /// The editor's content as HTML. Strings cross the interop boundary as UTF-8 JSON, so Swedish text is safe.
    /// Throws <see cref="InvalidOperationException"/> (Swedish message, for the page to show) when it can't be read,
    /// rather than handing back the old text and losing what was typed.
    /// </summary>
    public async Task<string> GetHtmlAsync()
    {
        if (_module is null || _editor is null) return InitialHtml ?? "";
        try
        {
            return await _module.InvokeAsync<string>("getHtml", _editor);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            throw new InvalidOperationException("Texten i redigeraren kunde inte läsas.", ex);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_editor is not null) await _editor.DisposeAsync();
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The WebView is already gone; nothing to clean up.
        }
    }
}
