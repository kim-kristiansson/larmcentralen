@inherits KnowledgeBaseComponent
@* A button for actions that need the server. Disabled with an explanation while offline. *@
<button type="@Type" class="@Class" disabled="@(!IsOnline || Disabled)"
        title="@(IsOnline ? Title : "Kräver anslutning till servern")" @onclick="OnClick">
    @ChildContent
</button>

@code {
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string Class { get; set; } = "btn";
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
