@implements IAsyncDisposable
@inject IThemeStore Store
@inject IJSRuntime JS
@using Microsoft.Extensions.Logging
@inject ILogger<ThemeSwitch> Logger
@* Chooses Auto (follow Windows), Ljust or Mörkt as three big buttons (easy on a touch screen).
   The choice is stored by the host and applied to <html> by theme.js.
   With Headless="true" it shows nothing and only applies the stored choice: MainLayout uses that so the
   theme is right on every page, while the buttons live on Inställningar. *@
@if (!Headless)
{
    <div class="segmented" role="radiogroup" aria-label="Tema">
        @foreach (var (value, label) in Choices)
        {
            <button type="button" role="radio" aria-checked="@(_current == value ? "true" : "false")"
                    class="segment @(_current == value ? "selected" : "")" @onclick="() => ChooseAsync(value)">
                @label
            </button>
        }
    </div>
}

@code {
    [Parameter] public bool Headless { get; set; }

    private static readonly (ThemePreference Value, string Label)[] Choices =
        [(ThemePreference.Auto, "Auto"), (ThemePreference.Light, "Ljust"), (ThemePreference.Dark, "Mörkt")];

    private IJSObjectReference? _module;
    private ThemePreference _current;

    protected override void OnInitialized() => _current = Store.Load();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Brings the page in line with the stored choice (also fills localStorage for the next start).
        if (firstRender && Headless) await ApplyAsync(_current);
    }

    private async Task ChooseAsync(ThemePreference choice)
    {
        _current = choice;
        Store.Save(choice);
        await ApplyAsync(choice);
    }

    /// <summary>The theme is cosmetic: a failure here is logged and must never break the page.</summary>
    private async Task ApplyAsync(ThemePreference preference)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Larmcentralen.Client.UI/js/theme.js");
            await _module.InvokeVoidAsync("apply", Key(preference));
        }
        catch (JSDisconnectedException)
        {
            // The WebView is already gone.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not apply the theme {Theme}", preference);
        }
    }

    private static string Key(ThemePreference p) => p.ToString().ToLowerInvariant();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The WebView is already gone; nothing to clean up.
        }
    }
}
