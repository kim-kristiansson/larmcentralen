@inherits KnowledgeBaseComponent
@* Shows whether the app is online, when the local copy was last synced and the access level of the key.
   Sync errors are shown by SyncErrorBanner under the top bar. *@
<div class="status">
    <div class="status-live" role="status" aria-live="polite">
        @if (Kb.IsSyncing)
        {
            <span class="status-pill status-syncing"><span class="status-dot" aria-hidden="true"></span>Synkar…</span>
        }
        else if (IsOnline)
        {
            <span class="status-pill status-online"><span class="status-dot" aria-hidden="true"></span>Ansluten</span>
        }
        else
        {
            <span class="status-pill status-offline"><span class="status-dot" aria-hidden="true"></span>Offline</span>
        }
        <span class="status-detail">
            @(Kb.LastSyncedAt is { } synced ? $"synkad {Format.When(synced)}" : "aldrig synkad")
            · @(Kb.CanEdit ? "admin" : "läsbehörighet")
        </span>
    </div>
    <button type="button" class="btn btn-small" disabled="@Kb.IsSyncing" @onclick="SyncNow"
            title="Hämta senaste versionen från servern">
        Synka nu
    </button>
</div>

@code {
    private async Task SyncNow() => await Kb.SyncAsync();
}
