@page "/"
@inherits KnowledgeBaseComponent
@inject SearchState State
@inject RecentAlarms Recent
@inject NavigationManager Nav

<PageTitle>Sök larm · Larmcentralen</PageTitle>

<h1 class="visually-hidden">Sök larm</h1>

<div class="search-box">
    <input @ref="_input" type="search" class="search-input" placeholder="Sök larmkod, larm eller utrustning, t.ex. ”w2 temp”"
           aria-label="Sök larm" autocomplete="off" spellcheck="false"
           value="@State.Text" @oninput="OnTextChanged" />
</div>

<div class="filters">
    <label>
        <span>Område</span>
        <select value="@State.AreaId" @onchange="OnAreaChanged">
            <option value="">Alla</option>
            @foreach (var area in Kb.Index.Areas)
            {
                <option value="@area.Id">@area.Name</option>
            }
        </select>
    </label>
    <label>
        <span>Utrustning</span>
        <select value="@State.EquipmentId" @onchange="OnEquipmentChanged">
            <option value="">Alla</option>
            @foreach (var eq in Kb.Index.EquipmentInArea(State.AreaId))
            {
                <option value="@eq.Id">@EquipmentLabel(eq)</option>
            }
        </select>
    </label>
    <label>
        <span>Allvarlighet</span>
        <select value="@State.Severity" @onchange="OnSeverityChanged">
            <option value="">Alla</option>
            @foreach (var s in Severity.All)
            {
                <option value="@s">@s</option>
            }
        </select>
    </label>
    @if (HasFilters)
    {
        <button type="button" class="btn btn-link" @onclick="ClearFilters">Rensa filter</button>
    }
    <span class="spacer"></span>
    <OnlineButton Class="btn" OnClick="@(() => Nav.NavigateTo("larm/ny"))">Nytt larm</OnlineButton>
</div>

@if (!Kb.HasLocalData)
{
    <div class="notice">
        @if (IsOnline || Kb.IsSyncing)
        {
            <p>Hämtar larmen från servern…</p>
        }
        else
        {
            <p><strong>Ingen lokal kopia ännu.</strong> Anslut datorn till nätverket en gång, så sparas alla larm och lösningar och fungerar sedan även offline.</p>
        }
    </div>
}
else if (string.IsNullOrWhiteSpace(State.Text))
{
    @if (_recent.Count > 0)
    {
        <h2 class="section-title">Senast visade</h2>
        <AlarmList Items="_recent" />
    }
    else
    {
        <p class="muted hint">Börja skriva för att söka bland @Kb.Index.AlarmCount larm.</p>
    }
}
else
{
    <p class="result-count" aria-live="polite">
        @(_result.TotalCount == 1 ? "1 träff" : $"{_result.TotalCount} träffar")
    </p>
    @if (_result.TotalCount == 0)
    {
        <p class="muted">Inga larm matchar. Prova färre ord, eller larmkoden utan bokstaven (”200.4”).</p>
    }
    else
    {
        <AlarmList Items="_result.Items" />
        @if (_result.HasMore(_result.Items.Count))
        {
            <button type="button" class="btn btn-wide" @onclick="ShowMore">Visa fler</button>
        }
    }
}

@code {
    private ElementReference _input;
    private AlarmSearchResult _result = AlarmSearchResult.Empty;
    private IReadOnlyList<int> _recentIds = [];
    private IReadOnlyList<AlarmView> _recent = [];

    private bool HasFilters => State.AreaId is not null || State.EquipmentId is not null || State.Severity is not null;

    protected override async Task OnInitializedAsync()
    {
        await LoadRecentAsync();
    }

    protected override void Load()
    {
        _result = Kb.Index.Search(State.ToQuery());
        _recent = Kb.Index.GetByIds(_recentIds);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await _input.FocusAsync();
    }

    private async Task LoadRecentAsync()
    {
        _recentIds = await Recent.GetAsync();
        _recent = Kb.Index.GetByIds(_recentIds);
    }

    private void OnTextChanged(ChangeEventArgs e)
    {
        // The search runs against the in-memory copy in well under a millisecond, so no debounce is needed.
        State.Text = e.Value?.ToString() ?? "";
        State.ResetPaging();
        Load();
    }

    private void OnAreaChanged(ChangeEventArgs e)
    {
        State.AreaId = ParseId(e.Value);
        if (State.EquipmentId is { } eqId && Kb.Index.EquipmentInArea(State.AreaId).All(x => x.Id != eqId))
            State.EquipmentId = null;
        State.ResetPaging();
        Load();
    }

    private void OnEquipmentChanged(ChangeEventArgs e)
    {
        State.EquipmentId = ParseId(e.Value);
        State.ResetPaging();
        Load();
    }

    private void OnSeverityChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        State.Severity = string.IsNullOrEmpty(value) ? null : value;
        State.ResetPaging();
        Load();
    }

    private async Task ClearFilters()
    {
        State.AreaId = null;
        State.EquipmentId = null;
        State.Severity = null;
        State.ResetPaging();
        Load();
        await _input.FocusAsync();
    }

    private void ShowMore()
    {
        State.Shown += AlarmSearchQuery.PageSize;
        Load();
    }

    private static string EquipmentLabel(Equipment eq)
        => string.IsNullOrWhiteSpace(eq.DisplayName) ? eq.Title : $"{eq.DisplayName} ({eq.Title})";

    private static int? ParseId(object? value)
        => int.TryParse(value?.ToString(), out var id) ? id : null;
}
