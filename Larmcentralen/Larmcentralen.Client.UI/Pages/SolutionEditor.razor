@page "/larm/{AlarmId:int}/losning/ny"
@page "/larm/{AlarmId:int}/losning/{Id:int}/redigera"
@inherits KnowledgeBaseComponent
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Ny lösning" : "Redigera lösning") · Larmcentralen</PageTitle>

<p class="back"><a href="@BackUrl">← @(_alarm is null ? "Tillbaka till sökningen" : "Tillbaka till larmet")</a></p>

@if (!CanEdit)
{
    <h1 class="page-title">@(IsNew ? "Ny lösning" : "Redigera lösning")</h1>
    <NoEditAccess />
}
else if (_alarm is null || _own is null || (!IsNew && !_solutionFound))
{
    <h1 class="page-title">@(IsNew ? "Ny lösning" : "Redigera lösning")</h1>
    <p class="muted">@(_alarm is null ? "Larmet finns inte." : "Lösningen finns inte.")</p>
}
else
{
    var current = _alarm;
    <h1 class="page-title">@(IsNew ? "Ny lösning" : "Redigera lösning")</h1>
    <p class="muted">För larm <strong>@(current.Alarm.AlarmCode is null ? "" : $"{current.Alarm.AlarmCode} · ")@current.Alarm.Title</strong> på @UnitLabel(current)</p>

    @if (!IsOnline)
    {
        <p class="notice">Du är offline. Ändringar kan sparas när anslutningen är tillbaka.</p>
    }

    @if (Sharing && SelectedAlarms().Count > 1)
    {
        <div class="notice shared-banner" role="status">
            <p>Ändringen gäller @SelectedAlarms().Count larm: @string.Join(", ", SelectedAlarms().Select(a => a.Equipment.Title).Distinct())</p>
            @if (!IsNew && _linkedAtLoad > 1)
            {
                <p>
                    <OnlineButton Class="btn btn-small" OnClick="DetachAsync" Disabled="_saving"
                                  Title="Kopierar lösningen till bara det här larmet. De andra behåller originalet.">Gör en egen kopia för den här enheten</OnlineButton>
                </p>
            }
        </div>
    }

    <EditForm Model="_form" OnValidSubmit="SaveAsync" class="form">
        <DataAnnotationsValidator />

        <label>
            <span>Titel</span>
            <InputText @bind-Value="_form.Title" placeholder="t.ex. ”Byt termoelement”" />
            <ValidationMessage For="() => _form.Title" />
        </label>

        <div class="form-row">
            <label>
                <span>Uppskattad tid</span>
                <InputText @bind-Value="_form.EstimatedTime" placeholder="t.ex. 15 min" />
            </label>
            <label>
                <span>Ordning</span>
                <InputNumber @bind-Value="_form.SortOrder" />
            </label>
        </div>

        <div class="field">
            <span class="field-label">Lösning, steg för steg</span>
            <QuillEditor @ref="_editor" InitialHtml="@_initialHtml" />
        </div>

        @if (Sharing)
        {
            <fieldset class="also-for">
                <legend>Gäller även</legend>
                @if (_own.Alarms.Count > 1)
                {
                    <p class="hint">Visas redan på @string.Join(", ", _own.Units): samma larm på alla de enheterna.</p>
                }
                <p class="muted hint">Bocka i andra larm som har samma fel. Lösningen visas då på alla, och en ändring gäller alla.</p>

                @if (SameCodeSiblings() is { Count: > 0 } sameCode)
                {
                    var allTicked = sameCode.All(t => _selected.Contains(t.Key));
                    <button type="button" class="btn btn-small quick-select" @onclick="() => TickAll(sameCode, !allTicked)">
                        @(allTicked ? "Avmarkera" : "Alla") @TypePlural(current.Equipment) med samma kod (@UnitRange(sameCode.SelectMany(t => t.Units).Concat(_own.Units)))
                    </button>
                }

                @if (_rows.Count == 0)
                {
                    <p class="muted">@(AlarmIndex.TypeOf(current.Equipment) is null or AlarmIndex.OtherType
                        ? "Inga förslag för den här enheten. Sök nedan för att lägga till ett larm."
                        : $"Inga liknande larm på andra {TypePlural(current.Equipment)}. Sök nedan för att lägga till ett larm.")</p>
                }
                @foreach (var group in Groups())
                {
                    <div class="also-group" @key="group.Key">
                        <p class="also-group-title">
                            ”@group.Title”@if (group.SameText) {<span class="muted"> · samma text</span>}
                        </p>
                        <ul class="also-list">
                            @foreach (var row in group.Rows)
                            {
                                var key = row.Key;
                                <li @key="key">
                                    <label class="also-row">
                                        <input type="checkbox" checked="@_selected.Contains(key)" @onchange="e => Toggle(key, e.Value is true)" />
                                        <span class="also-unit">@string.Join(", ", row.Units)</span>
                                        @if (AlarmIndex.TypeOf(row.First.Equipment) is { } type)
                                        {
                                            <span class="also-type">@type</span>
                                        }
                                        <span class="also-text">@(row.First.Alarm.AlarmCode is null ? "" : $"{row.First.Alarm.AlarmCode} · ")@row.First.Alarm.Title</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    </div>
                }

                <div class="also-search">
                    <label>
                        <span>Lägg till ett annat larm</span>
                        <input type="search" placeholder="Sök larmkod, larm eller utrustning" autocomplete="off" spellcheck="false"
                               value="@_search" @oninput="OnSearch" />
                    </label>
                    @if (_searchHits.Count > 0)
                    {
                        <ul class="also-list also-hits">
                            @foreach (var hit in _searchHits)
                            {
                                var hitId = hit.Alarm.Id;
                                <li @key="hitId">
                                    <div class="also-row">
                                        <button type="button" class="btn btn-small" @onclick="() => Add(hit)">Lägg till</button>
                                        <span class="also-unit">@UnitLabel(hit)</span>
                                        @if (AlarmIndex.TypeOf(hit.Equipment) is { } type)
                                        {
                                            <span class="also-type">@type</span>
                                        }
                                        <span class="also-text">@(hit.Alarm.AlarmCode is null ? "" : $"{hit.Alarm.AlarmCode} · ")@hit.Alarm.Title</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <p class="muted">Inga fler larm matchar.</p>
                    }
                </div>
            </fieldset>
        }

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        <div class="form-actions">
            <OnlineButton Type="submit" Class="btn btn-primary" Disabled="_saving">@(_saving ? "Sparar…" : SaveText)</OnlineButton>
            <a class="btn" href="@BackUrl">Avbryt</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int AlarmId { get; set; }
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;
    private bool Sharing => Kb.Index.SupportsSharing;
    private string SaveText => Sharing && SelectedAlarms().Count > 1 ? $"Spara för {SelectedAlarms().Count} larm" : "Spara";

    private AlarmView? _alarm;
    /// <summary>Where the solution is attached for this alarm: its definition (all units sharing it), or the alarm alone.</summary>
    private SolutionTarget? _own;
    private bool _solutionFound;
    private int? _solutionId;
    private int _linkedAtLoad;
    private QuillEditor? _editor;
    private string? _initialHtml;
    private readonly SolutionForm _form = new();
    private (int AlarmId, int? Id)? _loadedFor;
    private bool _saving;
    private string? _error;

    /// <summary>Keys of the targets ticked to share this solution. Always includes this alarm's own target.</summary>
    private readonly HashSet<int> _selected = [];
    /// <summary>Rows in the "Gäller även" list: suggestions, current links and targets added by search.</summary>
    private List<SolutionTarget> _rows = [];
    private string _search = "";
    private IReadOnlyList<AlarmView> _searchHits = [];

    private string BackUrl => _alarm is null ? "" : $"larm/{_alarm.Alarm.Id}";

    protected override void OnParametersSet()
    {
        // Load once per solution: a background sync must not overwrite what the user is typing.
        if (_loadedFor == (AlarmId, Id)) return;
        _loadedFor = (AlarmId, Id);

        var details = Kb.Index.GetDetails(AlarmId);
        _alarm = Kb.Index.GetByIds([AlarmId]).FirstOrDefault();
        _own = Kb.Index.TargetFor(AlarmId);
        _selected.Clear();
        if (_own is not null) _selected.Add(_own.Key);

        var linked = new List<SolutionTarget>();
        if (IsNew)
        {
            // New solutions go last.
            _form.SortOrder = details is null || details.Solutions.Count == 0 ? 10 : details.Solutions.Max(s => s.SortOrder) + 10;
        }
        else
        {
            var solution = Kb.Index.GetSolution(Id!.Value);
            _solutionFound = solution is not null;
            if (solution is not null)
            {
                _solutionId = solution.Id;
                _form.Title = solution.Title;
                _form.EstimatedTime = solution.EstimatedTime;
                _form.SortOrder = solution.SortOrder;
                _initialHtml = solution.Content;
                linked = Kb.Index.TargetsForSolution(solution.Id).ToList();
                _linkedAtLoad = linked.Count;
                foreach (var t in linked) _selected.Add(t.Key);
            }
        }

        // Suggestions first (nothing pre-ticked), then where the solution already applies.
        _rows = Kb.Index.SiblingTargets(AlarmId)
            .Concat(linked)
            .Where(t => t.Key != _own?.Key)
            .DistinctBy(t => t.Key)
            .ToList();
    }

    /// <summary>Every alarm the solution will show on when saved.</summary>
    private IReadOnlyList<AlarmView> SelectedAlarms()
        => _rows.Where(t => _selected.Contains(t.Key)).Prepend(_own!).SelectMany(t => t.Alarms).DistinctBy(a => a.Alarm.Id).ToList();

    private IReadOnlyList<SolutionTarget> SameCodeSiblings()
    {
        var code = _alarm?.Alarm.AlarmCode;
        if (string.IsNullOrWhiteSpace(code) || AlarmIndex.TypeOf(_alarm!.Equipment) is not { } type) return [];
        return _rows
            .Where(t => AlarmIndex.TypeOf(t.First.Equipment) == type
                        && string.Equals(t.First.Alarm.AlarmCode?.Trim(), code.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private sealed record RowGroup(string Key, string Title, bool SameText, IReadOnlyList<SolutionTarget> Rows);

    /// <summary>Rows grouped by alarm text, the group with the same text as this alarm first.</summary>
    private IEnumerable<RowGroup> Groups()
    {
        var ownText = AlarmIndex.NormaliseText(_alarm?.Alarm.Title);
        return _rows
            .GroupBy(r => AlarmIndex.NormaliseText(r.First.Alarm.Title))
            .Select(g => new RowGroup(g.Key, g.First().First.Alarm.Title, g.Key == ownText, g.ToList()))
            .OrderByDescending(g => g.SameText)
            .ThenBy(g => g.Title, StringComparer.CurrentCultureIgnoreCase);
    }

    private void Toggle(int key, bool on)
    {
        if (key == _own?.Key) return;
        if (on) _selected.Add(key); else _selected.Remove(key);
    }

    private void TickAll(IEnumerable<SolutionTarget> targets, bool on)
    {
        foreach (var t in targets) Toggle(t.Key, on);
    }

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        var listed = _rows.Append(_own!).SelectMany(t => t.Alarms).Select(a => a.Alarm.Id).ToHashSet();
        _searchHits = string.IsNullOrWhiteSpace(_search)
            ? []
            : Kb.Index.Search(new AlarmSearchQuery(_search, Take: 30)).Items.Where(a => !listed.Contains(a.Alarm.Id)).Take(8).ToList();
    }

    private void Add(AlarmView alarm)
    {
        if (Kb.Index.TargetFor(alarm.Alarm.Id) is not { } target) return;
        if (target.Key != _own?.Key && _rows.All(r => r.Key != target.Key)) _rows.Add(target);
        _selected.Add(target.Key);
        var added = target.Alarms.Select(a => a.Alarm.Id).ToHashSet();
        _searchHits = _searchHits.Where(h => !added.Contains(h.Alarm.Id)).ToList();
    }

    private static string UnitLabel(AlarmView a)
        => string.IsNullOrWhiteSpace(a.Equipment.DisplayName) ? a.Equipment.Title : $"{a.Equipment.Title} ({a.Equipment.DisplayName})";

    /// <summary>"härdugnar", "anlöpningsugnar", "tvättar"; "enheter" for units without a type.</summary>
    private static string TypePlural(Equipment equipment)
        => AlarmIndex.TypeOf(equipment) is { } type ? type.ToLowerInvariant() + "ar" : "enheter";

    /// <summary>"T101–T104" for three or more units, otherwise "T101, T102".</summary>
    private static string UnitRange(IEnumerable<string> unitNames)
    {
        var units = unitNames.Distinct().Order(StringComparer.OrdinalIgnoreCase).ToList();
        return units.Count >= 3 ? $"{units[0]}–{units[^1]}" : string.Join(", ", units);
    }

    private async Task DetachAsync()
    {
        if (_solutionId is not { } solutionId) return;
        _saving = true;
        _error = null;
        try
        {
            var copyId = await Kb.WriteAsync((api, ct) => api.DetachSolutionAsync(AlarmId, solutionId, ct));
            // Keep what is typed: from now on the form edits the copy, which only this alarm's definition uses.
            _solutionId = copyId;
            _linkedAtLoad = 1;
            _own = Kb.Index.TargetFor(AlarmId);
            _selected.Clear();
            if (_own is not null) _selected.Add(_own.Key);
            _rows = Kb.Index.SiblingTargets(AlarmId).ToList();
            _loadedFor = (AlarmId, copyId);
            Nav.NavigateTo($"larm/{AlarmId}/losning/{copyId}/redigera", replace: true);
        }
        catch (Exception ex)
        {
            _error = $"Kopian kunde inte skapas. {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_alarm is null || _own is null || _editor is null) return;
        _saving = true;
        _error = null;
        try
        {
            var html = await _editor.GetHtmlAsync();
            var content = Format.IsEmptyHtml(html) ? null : html;
            var title = _form.Title.Trim();
            var time = string.IsNullOrWhiteSpace(_form.EstimatedTime) ? null : _form.EstimatedTime.Trim();

            // Definitions when the server has them, alarms for a server with shared solutions only,
            // and nothing for an older one (it keeps its single AlarmId).
            var targets = _rows.Where(t => _selected.Contains(t.Key)).Prepend(_own).ToList();
            List<int>? definitionIds = Kb.Index.SupportsDefinitions ? targets.Select(t => t.DefinitionId!.Value).Distinct().Order().ToList() : null;
            List<int>? alarmIds = !Kb.Index.SupportsDefinitions && Sharing ? targets.Select(t => t.First.Alarm.Id).Order().ToList() : null;

            if (IsNew)
                await Kb.WriteAsync((api, ct) => api.CreateSolutionAsync(
                    new CreateSolutionRequest(title, content, _form.SortOrder, time, AlarmId, alarmIds, definitionIds), ct));
            else
                await Kb.WriteAsync((api, ct) => api.UpdateSolutionAsync(
                    _solutionId!.Value, new UpdateSolutionRequest(title, content, _form.SortOrder, time, alarmIds, definitionIds), ct));

            Nav.NavigateTo($"larm/{AlarmId}");
        }
        catch (Exception ex)
        {
            _error = $"Lösningen kunde inte sparas. {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class SolutionForm
    {
        [Required(ErrorMessage = "Ange en titel.")]
        [MaxLength(300, ErrorMessage = "Högst 300 tecken.")]
        public string Title { get; set; } = "";

        [MaxLength(50, ErrorMessage = "Högst 50 tecken.")]
        public string? EstimatedTime { get; set; }

        public int SortOrder { get; set; } = 10;
    }
}
