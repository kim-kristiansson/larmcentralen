@page "/installningar/utrustning"
@inherits KnowledgeBaseComponent
@using Larmcentralen.Client.Core.Api

<PageTitle>Utrustning · Larmcentralen</PageTitle>

<p class="back"><a href="installningar">← Tillbaka till inställningar</a></p>
<h1 class="page-title">Utrustning</h1>

@if (!CanEdit)
{
    <NoEditAccess />
}
else
{
    @if (!IsOnline)
    {
        <p class="notice">Du är offline. Ändringar kan sparas när anslutningen är tillbaka.</p>
    }

    <p class="muted intro">Lägg till, ändra och ta bort avdelningar och enheter. Det du tar bort hamnar i <a href="installningar/papperskorg">papperskorgen</a> med allt som hör till, och kan återställas där i 30 dagar.</p>

    @if (_mode == Mode.None)
    {
        <div class="toolbar">
            <OnlineButton Class="btn btn-primary" Disabled="@(Kb.Index.Areas.Count == 0)"
                          Title="@(Kb.Index.Areas.Count == 0 ? "Lägg till en avdelning först" : null)"
                          OnClick="@(() => StartNewUnit(null))">Ny enhet</OnlineButton>
            <OnlineButton Class="btn" OnClick="StartNewArea">Ny avdelning</OnlineButton>
        </div>
    }
    else if (_mode is Mode.NewArea or Mode.EditArea)
    {
        <div class="editor">
        <EditForm Model="_area" OnValidSubmit="SaveAreaAsync" class="form">
            <DataAnnotationsValidator />
            <h2 class="form-title">@(_mode == Mode.NewArea ? "Ny avdelning" : "Byt namn på avdelningen")</h2>
            <label>
                <span>Namn</span>
                <InputText @bind-Value="_area.Title" placeholder="t.ex. SQ-linjen (OCSS)" />
                <ValidationMessage For="() => _area.Title" />
            </label>
            @if (_error is not null)
            {
                <p class="error" role="alert">@_error</p>
            }
            <div class="form-actions">
                <OnlineButton Type="submit" Class="btn btn-primary" Disabled="_saving">@(_saving ? "Sparar…" : "Spara")</OnlineButton>
                <button type="button" class="btn" @onclick="Close" disabled="@_saving">Avbryt</button>
            </div>
        </EditForm>
        </div>
    }
    else
    {
        <div class="editor">
        <EditForm Model="_unit" OnValidSubmit="SaveUnitAsync" class="form">
            <DataAnnotationsValidator />
            <h2 class="form-title">@(_mode == Mode.NewUnit ? "Ny enhet" : $"Ändra {_editingTitle}")</h2>
            <div class="form-row">
                <label>
                    <span>Beteckning</span>
                    <InputText @bind-Value="_unit.Title" placeholder="t.ex. T101" />
                    <ValidationMessage For="() => _unit.Title" />
                </label>
                <label>
                    <span>Namn i vardagslag <span class="optional">(valfritt)</span></span>
                    <InputText @bind-Value="_unit.DisplayName" placeholder="t.ex. Härdugn 1" />
                </label>
            </div>
            <div class="form-row">
                <label>
                    <span>Typ</span>
                    <InputSelect @bind-Value="_unit.EquipmentType">
                        @foreach (var type in TypeOptions)
                        {
                            <option value="@type">@type</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <span>Avdelning</span>
                    <InputSelect @bind-Value="_unit.AreaId">
                        <option value="0">Välj avdelning…</option>
                        @foreach (var area in Kb.Index.Areas)
                        {
                            <option value="@area.Id">@area.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _unit.AreaId" />
                </label>
            </div>
            @if (_error is not null)
            {
                <p class="error" role="alert">@_error</p>
            }
            <div class="form-actions">
                <OnlineButton Type="submit" Class="btn btn-primary" Disabled="_saving">@(_saving ? "Sparar…" : "Spara")</OnlineButton>
                <button type="button" class="btn" @onclick="Close" disabled="@_saving">Avbryt</button>
            </div>
        </EditForm>
        </div>
    }

    @if (_message is not null)
    {
        <p class="success" role="status">
            @_message
            @if (_trashLink)
            {
                <a class="trash-link" href="installningar/papperskorg">Öppna papperskorgen</a>
            }
        </p>
    }
    @if (_listError is not null)
    {
        <p class="error" role="alert">@_listError</p>
    }

    @if (Kb.Index.Areas.Count == 0)
    {
        <p class="muted">Inga avdelningar ännu.</p>
    }

    @foreach (var area in Kb.Index.Areas)
    {
        var units = Kb.Index.EquipmentInArea(area.Id).OrderBy(e => e.Title, AlarmIndex.NaturalOrder).ToList();
        <section class="area" aria-labelledby="area-@area.Id">
            <header class="area-head">
                <h2 id="area-@area.Id">@area.Name</h2>
                <span class="count">@(units.Count == 1 ? "1 enhet" : $"{units.Count} enheter")</span>
                <span class="spacer"></span>
                <OnlineButton Class="btn btn-small" OnClick="@(() => StartNewUnit(area.Id))">Ny enhet här</OnlineButton>
                <OnlineButton Class="btn btn-small" OnClick="@(() => StartEditArea(area))">Byt namn</OnlineButton>
                <OnlineButton Class="btn btn-small btn-danger-outline" OnClick="@(() => AskDeleteArea(area))">Ta bort</OnlineButton>
            </header>
            @if (units.Count == 0)
            {
                <p class="muted empty">Inga enheter på avdelningen.</p>
            }
            else
            {
                <ul class="units">
                    @foreach (var unit in units)
                    {
                        var alarms = Kb.Index.AlarmCountFor(unit.Id);
                        <li class="unit">
                            <span class="unit-title">@unit.Title</span>
                            @if (!string.IsNullOrWhiteSpace(unit.DisplayName))
                            {
                                <span class="unit-name">@unit.DisplayName</span>
                            }
                            <span class="unit-type">@(AlarmIndex.TypeOf(unit) ?? AlarmIndex.OtherType)</span>
                            <span class="unit-alarms">@(alarms == 1 ? "1 larm" : $"{alarms} larm")</span>
                            <span class="spacer"></span>
                            <OnlineButton Class="btn btn-small" OnClick="@(() => StartEditUnit(unit))">Ändra</OnlineButton>
                            <OnlineButton Class="btn btn-small btn-danger-outline" OnClick="@(() => AskDeleteUnit(unit))">Ta bort</OnlineButton>
                        </li>
                    }
                </ul>
            }
        </section>
    }

    <ConfirmDialog Open="@(_confirm is not null)"
                   Title="@(_confirm?.Title ?? "")"
                   Message="@(_confirm?.Message ?? "")"
                   ConfirmText="Flytta till papperskorgen"
                   OnConfirm="DeleteAsync"
                   OnCancel="@(() => _confirm = null)" />
}

@code {
    /// <summary>The usual unit types at the plant, offered first. Types already in use are added after them.</summary>
    private static readonly string[] StandardTypes = ["Härdugn", "Anlöpningsugn", "Tvätt", AlarmIndex.OtherType];

    private enum Mode { None, NewArea, EditArea, NewUnit, EditUnit }

    private Mode _mode;
    private int? _editingId;
    private string? _editingTitle;
    private readonly AreaForm _area = new();
    private readonly UnitForm _unit = new();
    private bool _saving;
    private string? _error;
    private string? _listError;
    private string? _message;
    /// <summary>The last message was about a removal: offer the way to undo it.</summary>
    private bool _trashLink;
    private PendingDelete? _confirm;

    private sealed record PendingDelete(string Title, string Message, Func<Task> Delete, string Done);

    private IEnumerable<string> TypeOptions
    {
        get
        {
            var types = StandardTypes.Concat(Kb.Index.EquipmentTypes()).ToList();
            // A unit being edited keeps its type in the list even if it is unusual.
            if (!string.IsNullOrWhiteSpace(_unit.EquipmentType)) types.Add(_unit.EquipmentType);
            return types.Distinct(StringComparer.CurrentCultureIgnoreCase);
        }
    }

    private void Reset()
    {
        _trashLink = false;
        _error = null;
        _listError = null;
        _message = null;
        _editingId = null;
        _editingTitle = null;
    }

    private void StartNewArea()
    {
        Reset();
        _area.Title = "";
        _mode = Mode.NewArea;
    }

    private void StartEditArea(Area area)
    {
        Reset();
        _editingId = area.Id;
        _area.Title = area.Title;
        _mode = Mode.EditArea;
    }

    private void StartNewUnit(int? areaId)
    {
        Reset();
        _unit.Title = "";
        _unit.DisplayName = null;
        _unit.EquipmentType = StandardTypes[0];
        _unit.AreaId = areaId ?? (Kb.Index.Areas.Count == 1 ? Kb.Index.Areas[0].Id : 0);
        _mode = Mode.NewUnit;
    }

    private void StartEditUnit(Equipment unit)
    {
        Reset();
        _editingId = unit.Id;
        _editingTitle = unit.Title;
        _unit.Title = unit.Title;
        _unit.DisplayName = unit.DisplayName;
        _unit.EquipmentType = AlarmIndex.TypeOf(unit) ?? AlarmIndex.OtherType;
        _unit.AreaId = unit.AreaId;
        _mode = Mode.EditUnit;
    }

    private void Close()
    {
        _mode = Mode.None;
        _error = null;
    }

    private async Task SaveAreaAsync()
    {
        _saving = true;
        _error = null;
        var title = _area.Title.Trim();
        var request = new SaveAreaRequest(title);
        try
        {
            if (_mode == Mode.NewArea)
            {
                await Kb.WriteAsync((api, ct) => api.CreateAreaAsync(request, ct));
                _message = $"Avdelningen {title} är tillagd.";
            }
            else
            {
                var id = _editingId!.Value;
                await Kb.WriteAsync((api, ct) => api.UpdateAreaAsync(id, request, ct));
                _message = $"Avdelningen heter nu {title}.";
            }
            _mode = Mode.None;
        }
        catch (Exception ex)
        {
            _error = $"Avdelningen kunde inte sparas. {Reason(ex)}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveUnitAsync()
    {
        _saving = true;
        _error = null;
        var title = _unit.Title.Trim();
        // "" (not null) for a blank everyday name, so clearing it on edit really clears it.
        var request = new SaveEquipmentRequest(title, _unit.DisplayName?.Trim() ?? "", _unit.AreaId, _unit.EquipmentType ?? "");
        try
        {
            if (_mode == Mode.NewUnit)
            {
                await Kb.WriteAsync((api, ct) => api.CreateEquipmentAsync(request, ct));
                _message = $"{title} är tillagd.";
            }
            else
            {
                var id = _editingId!.Value;
                await Kb.WriteAsync((api, ct) => api.UpdateEquipmentAsync(id, request, ct));
                _message = $"{title} är sparad.";
            }
            _mode = Mode.None;
        }
        catch (Exception ex)
        {
            _error = $"Enheten kunde inte sparas. {Reason(ex)}";
        }
        finally
        {
            _saving = false;
        }
    }

    private Task AskDeleteArea(Area area) => AskDeleteAsync(true, area.Id, area.Name,
        () => Kb.WriteAsync((api, ct) => api.DeleteAreaAsync(area.Id, ct)),
        $"Avdelningen {area.Name} ligger nu i papperskorgen.");

    private Task AskDeleteUnit(Equipment unit) => AskDeleteAsync(false, unit.Id, unit.Title,
        () => Kb.WriteAsync((api, ct) => api.DeleteEquipmentAsync(unit.Id, ct)),
        $"{unit.Title} ligger nu i papperskorgen.");

    /// <summary>Asks the server what would go along (the confirmation names it), then asks the admin.</summary>
    private async Task AskDeleteAsync(bool isArea, int id, string name, Func<Task> delete, string done)
    {
        Reset();
        TrashPreview preview;
        try
        {
            preview = await Kb.CallApiAsync((api, ct) => api.PreviewRemovalAsync(isArea, id, ct));
        }
        catch (Exception ex)
        {
            _listError = $"Det gick inte att ta bort. {Reason(ex)}";
            return;
        }

        var along = Format.Contents(isArea ? preview.EquipmentCount : 0, preview.AlarmCount, preview.SolutionCount);
        var what = isArea ? "Avdelningen" : "Enheten";
        var message = along is null
            ? $"{what} flyttas till papperskorgen och försvinner för alla."
            : $"{what} flyttas till papperskorgen med {along} och försvinner för alla.";
        if (preview.AlarmCount > 0)
            message += " Åtgärder som delas med larm som finns kvar stannar kvar.";
        message += " Du kan återställa allt i Inställningar → Papperskorg i 30 dagar.";
        _confirm = new PendingDelete($"Ta bort {name}?", message, delete, done);
    }

    private async Task DeleteAsync()
    {
        var pending = _confirm;
        _confirm = null;
        if (pending is null) return;
        if (_mode != Mode.None) Close();
        try
        {
            await pending.Delete();
            _message = pending.Done;
            _trashLink = true;
        }
        catch (Exception ex)
        {
            _listError = $"Det gick inte att ta bort. {Reason(ex)}";
        }
    }

    /// <summary>The API's own explanation (it writes it in Swedish) when there is one, else the general message.</summary>
    private static string Reason(Exception ex) => ex is ApiException { Detail: { } detail } ? detail : ex.Message;

    private sealed class AreaForm
    {
        [Required(ErrorMessage = "Ange avdelningens namn.")]
        [MaxLength(100, ErrorMessage = "Högst 100 tecken.")]
        public string Title { get; set; } = "";
    }

    private sealed class UnitForm
    {
        [Required(ErrorMessage = "Ange enhetens beteckning, t.ex. T101.")]
        [MaxLength(200, ErrorMessage = "Högst 200 tecken.")]
        public string Title { get; set; } = "";

        [MaxLength(200, ErrorMessage = "Högst 200 tecken.")]
        public string? DisplayName { get; set; }

        public string? EquipmentType { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Välj en avdelning.")]
        public int AreaId { get; set; }
    }
}
