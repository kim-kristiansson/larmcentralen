<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Client logic with no UI and no MAUI dependency: API client, local SQLite copy,
    sync and offline search. Talks to the backend over HTTP only, so it has no
    project references to the API, Application or Domain projects.
  -->
  <PropertyGroup>
    <TargetFramework>$(LarmTargetFramework)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Larmcentralen.Client.Core.Tests" />
  </ItemGroup>

</Project>
