<Project>
  <!-- Central package versions. Microsoft.* runtime packages move together with the .NET version. -->
  <PropertyGroup>
    <DotNetPackageVersion Condition="'$(DotNetPackageVersion)' == ''">11.0.0</DotNetPackageVersion>
    <!-- Only used by tools/Larmcentralen.PostgresImport (one-time copy from the old database). -->
    <NpgsqlPackageVersion Condition="'$(NpgsqlPackageVersion)' == ''">11.0.0</NpgsqlPackageVersion>
    <MauiPackageVersion Condition="'$(MauiPackageVersion)' == ''">11.0.10</MauiPackageVersion>
  </PropertyGroup>

  <ItemGroup Label="Backend">
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(DotNetPackageVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(DotNetPackageVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(DotNetPackageVersion)" />
    <PackageVersion Include="Microsoft.Graph" Version="5.103.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(DotNetPackageVersion)" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="11.0.1" />
  </ItemGroup>

  <ItemGroup Label="Tools">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlPackageVersion)" />
  </ItemGroup>

  <ItemGroup Label="Client">
    <PackageVersion Include="CommunityToolkit.Maui" Version="17.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="$(DotNetPackageVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiPackageVersion)" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="$(DotNetPackageVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(DotNetPackageVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(DotNetPackageVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="$(DotNetPackageVersion)" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiPackageVersion)" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
